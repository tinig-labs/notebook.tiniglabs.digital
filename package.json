{
  "name": "notebook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && node scripts/build-sw.mjs --open-next && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/build-sw.mjs --open-next && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.6.0-beta",
    "@neondatabase/serverless": "^1.2.1",
    "dexie": "^4.0.11",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.2",
    "lucide-react": "^0.544.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.163.0"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
