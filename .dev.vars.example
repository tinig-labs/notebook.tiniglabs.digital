# Neon (pooled URL for the app, direct URL for migrations). Region: Singapore (aws-ap-southeast-1).
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth, email OTP sign-in)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-32

# Master key that wraps every user's data key. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never rotate by replacing: add NOTEBOOK_KEK_V2 and bump KEK_VERSION in src/lib/crypto/server.ts.
NOTEBOOK_KEK=

# Modal POWSM-CTC phoneme endpoint (modal/notebook_phonemes.py). In .dev.vars.staging, use the
# tinig-notebook-phonemes-staging app's URL and the PHONEMES_TOKEN from its own Modal secret.
MODAL_ENDPOINT_URL=
MODAL_TOKEN=
CRON_SECRET=generate-a-long-random-string
ADMIN_EMAILS=

# Azure Communication Services (email) and Cloudflare Turnstile
ACS_ACCESS_KEY=
TURNSTILE_SECRET_KEY=
